<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="CardTemplate">
        <Border x:Name="CardBorder"
                Width="220"
                Height="110"
                Margin="0,0,15,15"
                CornerRadius="{StaticResource Radius.M}"
                Padding="{StaticResource Spacing.M}"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                Effect="{StaticResource Shadow.S}"
                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="1" Margin="{StaticResource Spacing.M.Top}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Spacing.S.Bottom}">
                        <TextBlock Text="&#xE77B;" 
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontFamily="{StaticResource IconFontFamily}" 
                                   Margin="{StaticResource Spacing.M.Right}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextTertiary}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontFamily="{StaticResource IconFontFamily}" 
                                   Margin="{StaticResource Spacing.M.Right}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Host}" FontFamily="Consolas" Foreground="{DynamicResource TextTertiary}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <TextBlock x:Name="StatusLabel"
                               Text="● Offline"
                               FontSize="12"
                               Margin="2,0,0,0"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource ErrorForeground}"
                               VerticalAlignment="Bottom" />

                    <StackPanel x:Name="ActionButtons"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" />
                        </StackPanel.RenderTransform>
                        <Button Content="&#xE70F;"
                                Style="{StaticResource IconButtonStyle}"
                                BorderThickness="0" 
                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="&#xE74D;"
                                Style="{StaticResource IconButtonStyle}"
                                BorderThickness="0" 
                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Margin="{StaticResource Spacing.S.Left}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                <Setter TargetName="StatusLabel" Property="Text" Value="● Online" />
                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SuccessForeground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource Shadow.M}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActionButtons"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActionButtons"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="HomeListTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource ExpanderStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <StackPanel x:Name="GroupActionButtons"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Opacity="0">
                                        <Button Content="&#xE70F;"
                                                Style="{StaticResource IconButtonStyle}"
                                                BorderThickness="0" 
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource IconButtonStyle}"
                                                BorderThickness="0" 
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="{StaticResource Spacing.S.Left}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GroupActionButtons"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GroupActionButtons"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>