<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="CardTemplate">
        <Border Width="240"
                Height="120"
                Padding="10,10,10,5"
                Margin="0,0,15,15"
                CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="8" Opacity="0.07" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="8" Opacity="0.15" ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="&#xE968;" Style="{StaticResource IconTextBlockStyle}" />
                        <TextBlock Text="{Binding Host}" Style="{StaticResource DataTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource IconTextBlockStyle}" />
                        <TextBlock Text="{Binding Username}" Style="{StaticResource DataTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusIcon"
                                   Text="&#xF136;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="6"
                                   Foreground="{DynamicResource ErrorForeground}"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLabel"
                                   Text="Offline"
                                   FontSize="12"
                                   Foreground="{DynamicResource ErrorForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="ActionButtons"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Opacity="0">
                        <Button Content="&#xE70F;"
                                Style="{StaticResource IconButtonStyle}" />
                        <Button Content="&#xE74D;"
                                Style="{StaticResource IconButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                <Setter TargetName="StatusIcon" Property="Text" Value="&#xEC61;" />
                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SuccessForeground}" />
                <Setter TargetName="StatusLabel" Property="Text" Value="Online" />
                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SuccessForeground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionButtons" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="HomeListTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ServerGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource ServerGroupExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>