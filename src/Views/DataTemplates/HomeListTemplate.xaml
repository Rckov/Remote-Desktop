<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="CardTemplate">
        <Border Width="240"
                Height="120"
                Padding="5"
                Margin="0,0,15,0"
                CornerRadius="8"
                Background="{DynamicResource NeutralBackground1}"
                BorderBrush="{DynamicResource NeutralStroke1}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.14" BlurRadius="8" ShadowDepth="2" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource NeutralForeground1}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="&#xE968;" Style="{StaticResource IconTextBlockStyle}" />
                        <TextBlock Text="{Binding Host}" Style="{StaticResource DataTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource IconTextBlockStyle}" />
                        <TextBlock Text="{Binding Username}" Style="{StaticResource DataTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource DataTextBlockStyle}" 
                               Text="• Offline" 
                               Foreground="DarkRed"
                               VerticalAlignment="Center"/>

                    <StackPanel x:Name="ActionButtons"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Opacity="0">
                        <Button Content="&#xE70F;"
                                Style="{StaticResource IconButtonStyle}" />
                        <Button Content="&#xE74D;"
                                Style="{StaticResource IconButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionButtons" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="HomeListTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ServerGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource ServerGroupExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeutralForeground1}" />
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
