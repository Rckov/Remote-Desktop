<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ct="clr-namespace:RemoteDesktop.Views.UserControls">

    <DataTemplate x:Key="HomeContentTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ct:SearchBox Grid.Column="0" Width="300" HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Style="{StaticResource BaseButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" FontFamily="{DynamicResource FontIcon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="New Group" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BaseButtonStyle}" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontIcon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="New Server" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="&#xE713;" FontFamily="{DynamicResource FontIcon}" Style="{StaticResource BaseButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="16"
                    Background="{DynamicResource RegionBrush}">
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>