<UserControl x:Class="RemoteDesktop.Views.UserControls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SearchBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PageBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="Padding" Value="{StaticResource Spacing.S.Horizontal}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.S}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SearchBoxStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="{StaticResource Spacing.S.Horizontal}" />

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="{StaticResource Spacing.S.Horizontal}"
                     Padding="{StaticResource Spacing.M.Vertical}"
                     Foreground="{DynamicResource TextSecondary}"
                     CaretBrush="{DynamicResource TextSecondary}" />
        </Grid>
    </Border>
</UserControl>