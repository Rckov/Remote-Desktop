<Window x:Class="RemoteDesktop.Views.Dialogs.MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ct="clr-namespace:RemoteDesktop.Views.UserControls"
        SizeToContent="Height"
        Width="400"
        MinHeight="180"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource WindowStyle}">

    <Border Style="{StaticResource WindowBorder}" Background="{DynamicResource CardBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ct:WindowBar Title="{Binding Title}" ShowTitle="True" 
                          CanMaximized="False" 
                          CanMinimized="False" 
                          Background="{DynamicResource PageBackground}" />

            <Grid Grid.Row="1" Margin="5,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding OkCommand}"
                            MinWidth="75"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Cancel"
                            MinWidth="75"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource BaseButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
