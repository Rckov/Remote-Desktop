<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:RemoteDesktop.Common.Behaviors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="CardTemplate">
        <Border x:Name="CardBorder"
                Width="220"
                Height="110"
                Margin="{StaticResource Spacing.M}"
                CornerRadius="{StaticResource Radius.M}"
                Padding="{StaticResource Spacing.M}"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                Effect="{StaticResource Shadow.S}"
                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="1" Margin="{StaticResource Spacing.M.Top}" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="&#xE77B;"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource IconFontFamily}"
                               Margin="{StaticResource Spacing.M.Right}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Username}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="{StaticResource Spacing.S.Bottom}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="&#xE7F4;"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource IconFontFamily}"
                               Margin="{StaticResource Spacing.M.Right}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Host}"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextTertiary}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLabel"
                               Text="● Offline"
                               FontSize="12"
                               Margin="{StaticResource Spacing.S.Left}"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource ErrorForeground}"
                               VerticalAlignment="Bottom" />

                    <StackPanel x:Name="ActionButtons"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Opacity="0"
                                behaviors:FadeInOnHoverBehavior.IsEnabled="True">
                        <Button Content="&#xE70F;"
                                Style="{StaticResource IconButtonStyle}"
                                BorderThickness="0"
                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="&#xE74D;"
                                Style="{StaticResource IconButtonStyle}"
                                BorderThickness="0"
                                Margin="{StaticResource Spacing.S.Left}"
                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource Shadow.M}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                <Setter TargetName="StatusLabel" Property="Text" Value="● Online" />
                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SuccessForeground}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="HomeListTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource ExpanderStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <StackPanel x:Name="GroupActionButtons"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Opacity="0"
                                                behaviors:FadeInOnHoverBehavior.IsEnabled="True">
                                        <Button Content="&#xE70F;"
                                                Style="{StaticResource IconButtonStyle}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource IconButtonStyle}"
                                                BorderThickness="0"
                                                Margin="{StaticResource Spacing.S.Left}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>