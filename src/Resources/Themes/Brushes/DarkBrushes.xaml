<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundHover" Color="#363636" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="#202020" />

    <SolidColorBrush x:Key="PageBackground" Color="#202020" />

    <SolidColorBrush x:Key="ControlBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#252525" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#141414" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextTertiary" Color="#A0A0A0" />

    <SolidColorBrush x:Key="BorderDefault" Color="#454545" />

    <SolidColorBrush x:Key="AccentBackground" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentBackgroundHover" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentBackgroundPressed" Color="#0F548C" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ErrorForeground" Color="#F48B96" />
    <SolidColorBrush x:Key="SuccessForeground" Color="#9FD89F" />
</ResourceDictionary>