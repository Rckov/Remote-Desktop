<Application x:Class="RemoteDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/WindowStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/TextBoxStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/TabControl.xaml" />
                <ResourceDictionary Source="/Views/DataTemplates/HomeContentTemplate.xaml" />
                <ResourceDictionary Source="/Views/DataTemplates/ServerContentTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>