<Application x:Class="RemoteDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/Elevation.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Radius.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Spacing.xaml" />

                <ResourceDictionary Source="/Resources/Styles/WindowStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/TabControl.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ScrollBarStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ExpanderStyle.xaml" />

                <ResourceDictionary Source="/Views/DataTemplates/HomeListTemplate.xaml" />
                <ResourceDictionary Source="/Views/DataTemplates/HomeContentTemplate.xaml" />
                <ResourceDictionary Source="/Views/DataTemplates/ServerContentTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>